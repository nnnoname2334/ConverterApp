<Window x:Class="ConverterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конвертер величин" Height="450" Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <!-- Основной контейнер с отступами -->
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <!-- Заголовок приложения -->
            <RowDefinition Height="Auto"/>
            <!-- Разделитель -->
            <RowDefinition Height="10"/>
            <!-- Поле ввода числа -->
            <RowDefinition Height="Auto"/>
            <!-- Разделитель -->
            <RowDefinition Height="15"/>
            <!-- Группа выбора направления конвертации -->
            <RowDefinition Height="Auto"/>
            <!-- Разделитель -->
            <RowDefinition Height="20"/>
            <!-- Кнопка конвертации -->
            <RowDefinition Height="Auto"/>
            <!-- Разделитель -->
            <RowDefinition Height="15"/>
            <!-- Поле вывода результата -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== ЗАГОЛОВОК ===== -->
        <TextBlock Grid.Row="0"
                   Text="Конвертер величин"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="#2C3E50"/>

        <!-- ===== ПОЛЕ ВВОДА ===== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <!-- Подпись к полю ввода -->
            <TextBlock Text="Введите значение:"
                       VerticalAlignment="Center"
                       Width="160"
                       FontSize="14"/>
            <!-- Текстовое поле для ввода числового значения пользователем -->
            <TextBox x:Name="textBoxInput"
                     Width="220"
                     Height="32"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     Padding="8,0"
                     BorderBrush="#2980B9"
                     BorderThickness="2"/>
        </StackPanel>

        <!-- ===== ВЫБОР НАПРАВЛЕНИЯ КОНВЕРТАЦИИ ===== -->
        <!-- GroupBox визуально группирует RadioButton'ы -->
        <GroupBox Grid.Row="4"
                  Header="Направление конвертации"
                  FontSize="13"
                  FontWeight="SemiBold"
                  Padding="10,5">
            <StackPanel>
                <!-- RadioButton для выбора конвертации метры → километры -->
                <!-- GroupName="ConversionType" позволяет выбрать только один вариант из группы -->
                <RadioButton x:Name="radioMetersToKm"
                             Content="Метры  →  Километры"
                             GroupName="ConversionType"
                             IsChecked="True"
                             FontSize="13"
                             Margin="0,4"/>

                <!-- RadioButton для выбора конвертации километры → метры -->
                <RadioButton x:Name="radioKmToMeters"
                             Content="Километры  →  Метры"
                             GroupName="ConversionType"
                             FontSize="13"
                             Margin="0,4"/>

                <!-- RadioButton для выбора конвертации Цельсий → Фаренгейт -->
                <RadioButton x:Name="radioCelsiusToF"
                             Content="Градусы Цельсия  →  Градусы Фаренгейта"
                             GroupName="ConversionType"
                             FontSize="13"
                             Margin="0,4"/>

                <!-- RadioButton для выбора конвертации Фаренгейт → Цельсий -->
                <RadioButton x:Name="radioFToCelsius"
                             Content="Градусы Фаренгейта  →  Градусы Цельсия"
                             GroupName="ConversionType"
                             FontSize="13"
                             Margin="0,4"/>
            </StackPanel>
        </GroupBox>

        <!-- ===== КНОПКА КОНВЕРТИРОВАТЬ ===== -->
        <!-- Click указывает обработчик события в Code-Behind -->
        <Button Grid.Row="6"
                x:Name="buttonConvert"
                Content="Конвертировать"
                Width="200"
                Height="38"
                FontSize="14"
                FontWeight="SemiBold"
                Background="#2980B9"
                Foreground="White"
                BorderThickness="0"
                HorizontalAlignment="Center"
                Click="buttonConvert_Click"/>

        <!-- ===== ПОЛЕ ВЫВОДА РЕЗУЛЬТАТА ===== -->
        <Border Grid.Row="8"
                BorderBrush="#2980B9"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,8"
                Background="#EBF5FB">
            <StackPanel Orientation="Horizontal">
                <!-- Подпись к результату -->
                <TextBlock Text="Результат:"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Width="100"/>
                <!-- Здесь будет отображаться результат конвертации -->
                <TextBlock x:Name="textBlockResult"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#1A5276"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
